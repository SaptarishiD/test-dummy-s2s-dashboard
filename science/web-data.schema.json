{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fuxi-dashboard/forecast.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "issue",
    "grid",
    "products",
    "weeks"
  ],
  "properties": {
    "schema_version": {
      "enum": [1, 2]
    },
    "domain": {
      "type": "object",
      "required": ["id", "label", "kind", "bounds"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "label": {"type": "string", "minLength": 1},
        "kind": {"enum": ["india", "configured_bbox"]},
        "bounds": {
          "type": "object",
          "required": ["north", "south", "west", "east"],
          "additionalProperties": {"type": "number"}
        }
      }
    },
    "issue": {
      "type": "object",
      "required": [
        "initialization",
        "information_cutoff",
        "model_state_time",
        "members",
        "lead_days",
        "status"
      ],
      "properties": {
        "initialization": {
          "type": "string"
        },
        "information_cutoff": {
          "type": "string"
        },
        "model_state_time": {
          "type": "string"
        },
        "members": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "lead_days": {
          "const": 42
        },
        "status": {
          "enum": [
            "green",
            "warning"
          ]
        }
      }
    },
    "grid": {
      "type": "object",
      "required": [
        "shape",
        "latitude",
        "longitude",
        "value_order"
      ],
      "properties": {
        "shape": {
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "items": false
        },
        "latitude": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "longitude": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "india_mask": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "boolean"
          }
        },
        "support_mask": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "boolean"}
        }
      }
    },
    "products": {
      "type": "object",
      "required": [
        "rainfall_total",
        "temperature_mean"
      ],
      "minProperties": 2,
      "maxProperties": 5
    },
    "weeks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "week",
          "valid_start",
          "valid_end",
          "fields",
          "summary"
        ],
        "properties": {
          "week": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "valid_start": {
            "type": "string"
          },
          "valid_end": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            }
          },
          "vectors": {
            "type": "object",
            "properties": {
              "wind850_anomaly": {
                "type": "object",
                "required": [
                  "u",
                  "v"
                ],
                "properties": {
                  "u": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "number"
                    }
                  },
                  "v": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
